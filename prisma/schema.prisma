
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.Char(64)
  adminUserId String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt])
}

model GeneralEnquiry {
  id          String   @id @default(cuid())
  fullName    String
  companyName String?
  email       String
  mobileNumber String
  enquiryType String
  subject     String
  message     String   @db.Text
  status      String   @default("NEW")
  adminNotes  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model BusinessEnquiry {
  id              String   @id @default(cuid())
  contactPerson   String
  businessName    String
  businessEmail   String
  mobileNumber    String
  businessType    String
  businessLocation String
  website         String?
  gstin           String?
  products        Json
  message         String?  @db.Text
  status          String   @default("NEW")
  adminNotes      String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([businessEmail])
}

model SampleRequest {
  id           String   @id @default(cuid())
  fullName     String
  companyName  String?
  email        String
  mobileNumber String
  customerType String
  products     Json
  address      String   @db.Text
  city         String
  state        String
  pinCode      String
  country      String
  message      String?  @db.Text
  status       String   @default("NEW")
  adminNotes   String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Product {
  id                String   @id
  name              String
  category          String
  description       String?  @db.Text
  tagline           String?  @db.VarChar(500)

  imageSrc          String?  @db.VarChar(1000)
  imageAlt          String?  @db.VarChar(500)
  backImageSrc      String?  @db.VarChar(1000)
  backImageAlt      String?  @db.VarChar(500)

  packSizes         Json?
  packFormat        String?
  pendingNote       String?  @db.Text

  isVisible         Boolean  @default(true)
  isFeatured        Boolean  @default(false)

  dishPhotoSrc      String?  @db.VarChar(1000)
  dishPhotoAlt      String?  @db.VarChar(500)
  dishPhotoFocus    String?  @db.VarChar(100)
  dishPhotoZoom     Float?

  sortOrder         Int      @default(0)

  dishPlatterItem   DishPlatterItem?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category, sortOrder])
  @@index([isVisible, isFeatured])
}

model DishPlatterItem {
  id        String   @id @default(cuid())
  dishId    String   @unique
  name      String
  imageSrc  String   @db.VarChar(1000)
  imageAlt  String   @db.VarChar(500)
  focus     String?  @db.VarChar(100)
  zoom      Float?
  sortOrder Int

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model CompanySettings {
  id          String   @id @default(cuid())
  companyName String
  email       String?
  address     String?  @db.Text
  fssaiNumber String?
  updatedAt   DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String
  url       String   @db.VarChar(1000)
  isVisible Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform])
  @@index([isVisible, sortOrder])
}
